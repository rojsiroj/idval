{
  "name": "idval",
  "version": "0.1.0",
  "description": "Parse and validate Indonesian data: NIK, NPWP, NITKU and phone numbers. Zero dependencies. Same results as the Go package.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rojsiroj/idval.git",
    "directory": "ts"
  },
  "keywords": ["indonesia", "nik", "npwp", "nitku", "ktp", "phone", "validation", "validator"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./nik": { "types": "./dist/nik.d.ts", "default": "./dist/nik.js" },
    "./npwp": { "types": "./dist/npwp.d.ts", "default": "./dist/npwp.js" },
    "./phone": { "types": "./dist/phone.d.ts", "default": "./dist/phone.js" }
  },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "cp ../README.md ../LICENSE . && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
